# ================================================================
# LUMINUS - ASSISTENTE PESSOAL PERSONALIZADO
# ARQUIVO: .env.example
# DESCRIÇÃO: Template de variáveis de ambiente (SUBSTITUA pelos valores reais)
# AUTOR: SILVANO MORAES DE SOUZA
# VERSÃO: 1.0.1
# ================================================================

# ================================================================
# SEGURANÇA - Token do webhook (OBRIGATÓRIO)
# ================================================================
WEBHOOK_SECRET=sua_chave_secreta_aqui

# ================================================================
# EVOLUTION API - Configuração do WhatsApp
# ================================================================
INSTANCE_NAME=meu_agente
EVOLUTION_API_URL=http://localhost:8085
EVOLUTION_API_KEY=antigravity_secret_key

# ================================================================
# GEMINI - APIs do Google (OBRIGATÓRIO)
# ================================================================
GEMINI_API_KEY_PRIMARY=SUA_CHAVE_PRIMARY_AQUI
GEMINI_API_KEY_FALLBACK=SUA_CHAVE_FALLBACK_AQUI

# ================================================================
# GROQ - API Opcional
# ================================================================
GROQ_API_KEY=SUA_CHAVE_GROQ_AQUI

# ================================================================
# OPENROUTER - API Alternativa
# ================================================================
OPENROUTER_API_KEY=SUA_CHAVE_OPENROUTER_AQUI

# ================================================================
# MOBILE NODE - API Local (Opcional)
# ================================================================
MOBILE_API_URL=http://localhost:1234/v1/chat/completions

# ================================================================
# CONFIGURAÇÃO - Contatos permitidos ( whitelist )
# Formato JSON: {"names": ["Nome1"], "numbers": ["55xxxxxxxxxxx"]}
# ================================================================
ALLOWED_CONTACTS={"names": ["Your Name"], "numbers": ["5500000000000"]}

# ================================================================
# OWNER AND DATABASES
# ================================================================
# Your own WhatsApp number (digits only, with country code). Messages from it
# get the owner persona.
OWNER_NUMBER=
# Passwords for the two Postgres containers in docker-compose.yml
LUMINUS_DB_PASSWORD=
EVOLUTION_DB_PASSWORD=
